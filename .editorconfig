root = true

[*]
charset = utf-8
end_of_line = crlf

# 说明：以下均为 IDE 实时分析产生的 info 级代码质量建议（非编译警告、非 bug）。
# 逐条修复侵入面大、收益低，统一静默以保持"问题"面板干净。
# 如后续需要恢复某条规则，把对应 severity 改回 info 即可。
[*.cs]
dotnet_diagnostic.CA1401.severity = silent
dotnet_diagnostic.CA1510.severity = silent
dotnet_diagnostic.CA1512.severity = silent
dotnet_diagnostic.CA1513.severity = silent
dotnet_diagnostic.CA1806.severity = silent
