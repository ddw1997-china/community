    <BitmapImage x:Key="GeoIconCone" UriSource="/Resources/Icons-png/geo-icons/cone_white.png"/>

    <!-- 直尺工具图标：长条尺身 + 上沿刻度（矢量绘制） -->
    <DrawingImage x:Key="GeoIconStraightRuler">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 2,10 L 30,10 L 30,22 L 2,22 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#F0F0F0" Thickness="2" LineJoin="Round"/>
                    </GeometryDrawing.Pen>
