<UserControl xmlns:props="clr-namespace:Ink_Canvas.Properties" x:Class="Ink_Canvas.Controls.BackgroundPalettePopupContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:controls="clr-namespace:Ink_Canvas.Controls;assembly=InkCanvas.Controls"
mc:Ignorable="d">
    <Grid>
        <controls:PopupShellContent x:Name="Shell" Title="{x:Static props:CanvasStrings.Canvas_BackgroundSettings}" d:Visibility="Collapsed" />
        <ContentControl x:Name="InnerContentHost" Visibility="Collapsed" d:Visibility="Visible">
            <ikw:SimpleStackPanel Margin="8" Spacing="4">
                <TextBlock Text="{x:Static props:CanvasStrings.Canvas_WhiteboardMode}"
                           Foreground="{DynamicResource TextForeground}"
                           FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <ikw:SimpleStackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                    <Border x:Name="WhiteboardModeBtn"
                            Width="50" Height="30"
                            Background="#2563eb"
                            CornerRadius="4">
                        <TextBlock Text="{x:Static props:FloatingBarStrings.FloatingBar_Whiteboard}" FontSize="10"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="BlackboardModeBtn"
                            Width="50" Height="30"
                            Background="LightGray"
                            CornerRadius="4">
                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_Blackboard}"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="DarkModeBtn"
                            Width="50" Height="30"
                            Background="LightGray"
                            CornerRadius="4">
                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_DarkMode}"
                                   Foreground="Black"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </ikw:SimpleStackPanel>
                <Border Height="1" d:Background="Green"
                        Background="{DynamicResource SettingsPageBorderBrush}"/>
                <TextBlock Text="{x:Static props:CanvasStrings.Canvas_BackgroundColor}"
                           Foreground="{DynamicResource TextForeground}"
                           FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <Border x:Name="BackgroundColorPreview"
                        Width="100" Height="40"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SettingsPageBorderBrush}"
                        Background="White"
                        CornerRadius="4"
                        HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="R:" Width="20"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextForeground}" />
                    <Slider x:Name="BackgroundRSlider"
                            Minimum="0" Maximum="255" Value="255"
                            Width="100"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="BackgroundRValue"
                               Text="255" Width="30"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextForeground}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="G:" Width="20"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextForeground}" />
                    <Slider x:Name="BackgroundGSlider"
                            Minimum="0" Maximum="255" Value="255"
                            Width="100"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="BackgroundGValue"
                               Text="255" Width="30"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextForeground}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="B:" Width="20"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextForeground}" />
                    <Slider x:Name="BackgroundBSlider"
                            Minimum="0" Maximum="255" Value="255"
                            Width="100"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="BackgroundBValue"
                               Text="255" Width="30"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextForeground}" />
                </StackPanel>
                <Button x:Name="ApplyBackgroundColorBtn"
                        Content="{x:Static props:CanvasStrings.Canvas_ApplyColor}"
                        Background="#2563eb"
                        Foreground="Black"
                        HorizontalAlignment="Center" />
                <Border Height="1" d:Background="Green"
                        Background="{DynamicResource SettingsPageBorderBrush}"/>
                <TextBlock Text="显示网格"
                           Foreground="{DynamicResource TextForeground}"
                           FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <CheckBox x:Name="GridLinesCheckBox"
                          Content="显示网格线"
                          HorizontalAlignment="Center"
                          Foreground="{DynamicResource TextForeground}"
                          FontSize="10" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="密度:" Width="35"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextForeground}"
                               FontSize="10"/>
                    <Slider x:Name="GridDensitySlider"
                            Minimum="10" Maximum="100" Value="20"
                            Width="100"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="GridDensityValue"
                               Text="20px" Width="40"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextForeground}"
                               FontSize="10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="亮度:" Width="35"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextForeground}"
                               FontSize="10"/>
                    <Slider x:Name="GridBrightnessSlider"
                            Minimum="0" Maximum="255" Value="229"
                            Width="100"
                            VerticalAlignment="Center" />
                    <TextBlock x:Name="GridBrightnessValue"
                               Text="229" Width="30"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Foreground="{DynamicResource TextForeground}"
                               FontSize="10" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="水平线:" Width="35"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextForeground}"
                               FontSize="10"/>
                    <CheckBox x:Name="GridHorizontalLinesCheckBox"
                              Content="显示"
                              HorizontalAlignment="Left"
                              Foreground="{DynamicResource TextForeground}"
                              FontSize="10"
                              IsChecked="True" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="竖直线:" Width="35"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextForeground}"
                               FontSize="10"/>
                    <CheckBox x:Name="GridVerticalLinesCheckBox"
                              Content="显示"
                              HorizontalAlignment="Left"
                              Foreground="{DynamicResource TextForeground}"
                              FontSize="10"
                              IsChecked="True" />
                </StackPanel>
            </ikw:SimpleStackPanel>
        </ContentControl>
    </Grid>
</UserControl>
